### App
APP_PUBLIC_URL=https://zap.trajettu.com
NODE_ENV=production
PORT=3000

### Banco
DATABASE_URL=postgres://postgres:senha@host:5432/zap?sslmode=disable

### Redis (BullMQ — agendamentos)
REDIS_URL=redis://default:senha@host:6379

### Auth admin (seed: npm run db:seed)
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria-min-32-chars
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@trajettu.com
ADMIN_PASSWORD=troque-esta-senha

### WPPConnect
WPP_BASE_URL=https://wpp.trajettu.com:21465
WPP_INTERNAL_URL=http://nome-servico-wpp:21465
WPP_SESSION=autofintech
WPP_SECRET_KEY=sua-chave-do-wppconnect

### Hotmart webhook (opcional)
HOTMART_WEBHOOK_SECRET=

### CORS
CORS_ORIGIN=https://zap.trajettu.com
