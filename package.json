{
  "name": "trajettu-zap",
  "private": true,
  "version": "1.0.0",
  "description": "Automação WhatsApp com WPPConnect e editor visual de fluxos",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch api/src/index.ts",
    "dev:worker": "tsx watch api/src/worker.ts",
    "dev:web": "vite web --config web/vite.config.ts --host 0.0.0.0 --port 5173",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p api/tsconfig.json",
    "build:web": "vite build web --config web/vite.config.ts",
    "start": "node api/dist/index.js",
    "worker": "node api/dist/worker.js",
    "lint": "eslint .",
    "format": "prettier -w .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx api/src/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.6.0",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^6.9.0",
    "@xyflow/react": "^12.6.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.53.0",
    "dotenv": "^16.6.1",
    "fastify": "^4.29.1",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "mustache": "^4.2.0",
    "prisma": "^6.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.5.2",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@tailwindcss/postcss": "^4.1.8",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "eslint": "^9.29.0",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
