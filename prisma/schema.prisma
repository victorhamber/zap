generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AppSettings {
  id                   String    @id @default("default")
  wppBaseUrl           String    @default("https://wpp.trajettu.com")
  wppSession           String    @default("autofintech")
  wppToken             String?
  wppTokenFull         String?
  connectionStatus     String?
  dismissedWppSessions Json      @default("[]")
  quickReplies         Json      @default("[]")
  inboxCaptureSince    DateTime?
  inboxOwnerPhone      String?
  inboxSessionState    Json      @default("{}")
  updatedAt            DateTime  @updatedAt
}

model InboxMessage {
  id          String   @id @default(cuid())
  session     String
  ownerPhone  String   @default("")
  chatId      String
  body        String   @default("")
  fromMe      Boolean  @default(false)
  source      String   @default("webhook")
  type        String   @default("chat")
  mediaUrl    String?
  waMessageId String?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([session, waMessageId])
  @@index([session, chatId, timestamp])
  @@index([session, ownerPhone, chatId, timestamp])
  // dashboard: contagens por período (últimos 7 dias, hoje)
  @@index([timestamp])
}

model InstanceAiSettings {
  id               String   @id @default(cuid())
  session          String   @unique
  enabled          Boolean  @default(false)
  learnEnabled     Boolean  @default(false)
  autoReplyEnabled Boolean  @default(false)
  learnTagIds      String[]
  learnText        Boolean  @default(true)
  learnImage       Boolean  @default(false)
  learnAudio       Boolean  @default(false)
  learnVideo       Boolean  @default(false)
  replyText        Boolean  @default(true)
  replyImage       Boolean  @default(true)
  replyAudio       Boolean  @default(true)
  replyVideo       Boolean  @default(true)
  productContext   String   @default("")
  /**
   * Fatos oficiais fixos — prioridade sobre aprendizado histórico (ex.: capital mínimo por tipo de conta).
   */
  officialFacts    String   @default("")
  rulesAllowed     String   @default("")
  rulesForbidden   String   @default("")
  officialLinks    Json     @default("[]")
  /**
   * Respostas com mídia disparadas por pergunta-gatilho. A IA envia texto+mídia
   * prontos quando o cliente pergunta algo equivalente. Ver AiMediaResponse.
   */
  mediaResponses   Json     @default("[]")
  openaiApiKeyEnc  String?
  modelChat        String   @default("gpt-4o-mini")
  modelVision      String   @default("gpt-4o-mini")
  modelTranscribe  String   @default("whisper-1")
  replyDelaySec    Int      @default(60)
  humanIdleSec     Int      @default(60)
  maxDailyReplies  Int      @default(200)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model InstanceAiKnowledge {
  id          String   @id @default(cuid())
  session     String
  chatId      String
  kind        String
  topic       String?
  content     String
  sourceMsgId String?
  modality    String   @default("text")
  createdAt   DateTime @default(now())

  @@index([session, chatId])
  @@index([session, createdAt])
}

model InstanceAiChatState {
  session             String
  chatId              String
  mode                String    @default("auto")
  lastHumanAt         DateTime?
  pendingReplyJobId   String?
  pendingInboundId    String?
  conversationSummary String    @default("")
  summaryMessageCount Int       @default(0)
  summaryUpdatedAt    DateTime?
  /**
   * Última mensagem do inbox já incorporada à memória persistente.
   */
  memoryLastMessageId String?

  @@unique([session, chatId])
}

model InstanceAiEvent {
  id        String   @id @default(cuid())
  session   String
  chatId    String?
  event     String
  detail    String?
  createdAt DateTime @default(now())

  @@index([session, createdAt])
}

model WppInstance {
  id                        String   @id @default(cuid())
  name                      String   @unique
  label                     String?
  /**
   * baileys = QR Evolution | business = API oficial Meta via Evolution
   */
  integration               String   @default("baileys")
  metaPhoneNumberId         String?
  metaBusinessId            String?
  metaAccessTokenEnc        String?
  metaWebhookVerifyTokenEnc String?
  createdAt                 DateTime @default(now())
}

model Flow {
  id               String    @id @default(cuid())
  name             String
  enabled          Boolean   @default(false)
  graphJson        Json
  schemaVersion    Int       @default(1)
  /** Último payload recebido no webhook personalizado (para mapear campos na UI). */
  webhookSample    Json?
  webhookSampleAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  runs             FlowRun[]
}

model FlowRun {
  id            String         @id @default(cuid())
  flowId        String
  flow          Flow           @relation(fields: [flowId], references: [id], onDelete: Cascade)
  triggerType   String
  contactPhone  String
  variables     Json           @default("{}")
  status        String         @default("running")
  currentNodeId String?
  externalId    String?
  errorMessage  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  steps         FlowRunStep[]
  scheduledJobs ScheduledJob[]

  @@unique([flowId, externalId])
  @@index([flowId])
  @@index([status])
  // dashboard: execuções de hoje / últimos 7 dias
  @@index([createdAt])
}

model FlowRunStep {
  id        String   @id @default(cuid())
  flowRunId String
  flowRun   FlowRun  @relation(fields: [flowRunId], references: [id], onDelete: Cascade)
  nodeId    String
  nodeType  String
  status    String
  message   String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([flowRunId])
}

model ScheduledJob {
  id        String   @id @default(cuid())
  flowRunId String
  flowRun   FlowRun  @relation(fields: [flowRunId], references: [id], onDelete: Cascade)
  nodeId    String
  bullJobId String?
  runAt     DateTime
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@index([flowRunId])
  @@index([runAt, status])
}

model Contact {
  id        String       @id @default(cuid())
  phone     String       @unique
  name      String?
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  tags      ContactTag[]
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  color     String       @default("#25D366")
  createdAt DateTime     @default(now())
  contacts  ContactTag[]
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}
