generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AppSettings {
  id              String   @id @default("default")
  wppBaseUrl      String   @default("https://wpp.trajettu.com")
  wppSession      String   @default("autofintech")
  wppToken        String?
  wppTokenFull    String?
  connectionStatus String?
  dismissedWppSessions Json @default("[]")
  quickReplies       Json      @default("[]")
  inboxCaptureSince  DateTime?
  inboxOwnerPhone    String?
  inboxSessionState  Json      @default("{}")
  updatedAt          DateTime  @updatedAt
}

model InboxMessage {
  id          String   @id @default(cuid())
  session     String
  ownerPhone  String   @default("")
  chatId      String
  body        String   @default("")
  fromMe      Boolean  @default(false)
  type        String   @default("chat")
  mediaUrl    String?
  waMessageId String?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([session, waMessageId])
  @@index([session, chatId, timestamp])
  @@index([session, ownerPhone, chatId, timestamp])
}

model WppInstance {
  id        String   @id @default(cuid())
  name      String   @unique
  label     String?
  createdAt DateTime @default(now())
}

model Flow {
  id          String   @id @default(cuid())
  name        String
  enabled     Boolean  @default(false)
  graphJson   Json
  schemaVersion Int    @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  runs        FlowRun[]
}

model FlowRun {
  id            String   @id @default(cuid())
  flowId        String
  flow          Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  triggerType   String
  contactPhone  String
  variables     Json     @default("{}")
  status        String   @default("running")
  currentNodeId String?
  externalId    String?
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  steps         FlowRunStep[]
  scheduledJobs ScheduledJob[]

  @@unique([flowId, externalId])
  @@index([flowId])
  @@index([status])
}

model FlowRunStep {
  id        String   @id @default(cuid())
  flowRunId String
  flowRun   FlowRun  @relation(fields: [flowRunId], references: [id], onDelete: Cascade)
  nodeId    String
  nodeType  String
  status    String
  message   String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([flowRunId])
}

model ScheduledJob {
  id         String   @id @default(cuid())
  flowRunId  String
  flowRun    FlowRun  @relation(fields: [flowRunId], references: [id], onDelete: Cascade)
  nodeId     String
  bullJobId  String?
  runAt      DateTime
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@index([flowRunId])
  @@index([runAt, status])
}

model Contact {
  id        String        @id @default(cuid())
  phone     String        @unique
  name      String?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  tags      ContactTag[]
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  color     String       @default("#25D366")
  createdAt DateTime     @default(now())
  contacts  ContactTag[]
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}
