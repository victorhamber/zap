### App
APP_PUBLIC_URL=https://zap.trajettu.com
ZAP_INTERNAL_URL=http://zap_zap:3000
NODE_ENV=production
PORT=3000

### Banco
DATABASE_URL=postgres://postgres:senha@zap_zap-db:5432/zap?sslmode=disable

### Redis (BullMQ — agendamentos)
REDIS_URL=redis://default:senha@zap_redis:6379

### Auth admin (seed: npm run db:seed)
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria-min-32-chars
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@trajettu.com
ADMIN_PASSWORD=troque-esta-senha

### WhatsApp — Evolution API (produção Trajettu)
WHATSAPP_PROVIDER=evolution
WHATSAPP_SESSION=ass
EVOLUTION_BASE_URL=https://evo.trajettu.com
EVOLUTION_INTERNAL_URL=http://zap_evolution-api:8080
EVOLUTION_API_KEY=sua-chave-global-evolution

### Hotmart webhook (opcional)
HOTMART_WEBHOOK_SECRET=

### CORS
CORS_ORIGIN=https://zap.trajettu.com

### Assistente IA
# Chave OpenAI: configure por instância no painel (Configurações → Assistente IA).
# Criptografia no banco usa JWT_SECRET automaticamente (AI_ENCRYPTION_KEY é opcional).
AI_REPLY_DELAY_SEC=60
AI_HUMAN_IDLE_SEC=60
AI_MAX_DAILY_REPLIES=200
# Backfill/histórico: 4000ms = ~4s entre jobs (2000 msgs ≈ 2h). Reduza se ainda der 429.
AI_LEARN_STAGGER_MS=6000
AI_WORKER_CONCURRENCY=1
AI_OPENAI_RPM_LIMIT=15
AI_HISTORY_MESSAGE_LIMIT=200
